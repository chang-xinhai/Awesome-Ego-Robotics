---
import { SITE } from "../lib/site";
import { sitePath } from "../lib/paths";
interface Props {
  pathname?: string;
}
---

<header class="site-header wrap">
  <a class="brand" href={sitePath()} aria-label="Awesome Ego Robotics home">
    <span class="brand-icon" aria-hidden="true">
      <svg viewBox="0 0 32 32">
        <path d="M5 12h8l2 2h2l2-2h8v8h-8l-3-3-3 3H5zM5 12 3 7m24 5 2-5" />
      </svg>
    </span>
    <span>Awesome Ego Robotics</span>
  </a>
  <nav aria-label="Main navigation">
    <a href={sitePath() + "#library"}>Library</a>
    <button type="button" data-roadmap>Roadmap</button>
    <button type="button" data-about>
      About
    </button>
    <a
      class="github-button"
      aria-label="GitHub repository"
      href={SITE.github}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.57 9.57 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"
        />
      </svg>
      <span>GitHub</span>
    </a>
  </nav>
</header>
